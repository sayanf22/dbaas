{
  "name": "@dbcloud/customer",
  "version": "0.0.0",
  "private": true,
  "description": "dbcloud customer dashboard: Next.js App Router static export (out/) served by Cloudflare Workers Static Assets. No server features; runtime data will come from control-api in client components.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && dbcloud-csp-headers",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@dbcloud/ui": "workspace:*",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "typescript": "6.0.3"
  }
}
