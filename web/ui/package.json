{
  "name": "@dbcloud/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared shadcn/ui-style components, Tailwind CSS v4 theme and the post-build CSP header generator for the dbcloud web apps. Contains no app logic, data fetching or routes.",
  "type": "module",
  "exports": {
    "./card": "./src/components/card.tsx",
    "./styles.css": "./src/styles.css"
  },
  "bin": {
    "dbcloud-csp-headers": "./scripts/csp-headers.mjs"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "react": "19.3.0",
    "typescript": "6.0.3"
  }
}
