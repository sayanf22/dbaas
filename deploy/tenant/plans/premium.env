# Plan `premium` (plan/03-cost-model.md §4-§5): ₹1,399 + GST (proposed). Memory request = limit on every container.
PLAN=premium
PG_CPU_REQ=500m
PG_CPU_LIM=1000m
PG_MEM=2Gi
STORAGE=20Gi
MAX_CONNECTIONS=100
SHARED_BUFFERS=512MB
ARCHIVE_TIMEOUT=1min
POOL_MAX_CLIENTS=400
POOL_SIZE=80
SIDECAR_CPU_REQ=5m
SIDECAR_CPU_LIM=200m
# 160 Mi: measured peak 142-145 MiB (anon) during a 1 GB base backup with concurrent WAL archiving (03 §5)
SIDECAR_MEM=160Mi
PGB_CPU_REQ=5m
PGB_CPU_LIM=100m
PGB_MEM=48Mi
