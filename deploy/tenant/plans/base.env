# Plan `base` (plan/03-cost-model.md §4-§5): ₹299 + GST. Memory request = limit on every container: the
# template takes them separately (*_MEM_REQ / *_MEM_LIM) so a burstable plan can set request < limit, but
# until the owner decides on burstable plans (plan/03 §5) every plan stays Guaranteed-memory.
PLAN=base
PG_CPU_REQ=100m
PG_CPU_LIM=500m
PG_MEM_REQ=512Mi
PG_MEM_LIM=512Mi
STORAGE=5Gi
MAX_CONNECTIONS=25
SHARED_BUFFERS=128MB
ARCHIVE_TIMEOUT=5min
POOL_MAX_CLIENTS=100
POOL_SIZE=20
SIDECAR_CPU_REQ=5m
SIDECAR_CPU_LIM=200m
# 160 Mi: measured peak 142-145 MiB (anon) during a 1 GB base backup with concurrent WAL archiving (03 §5)
SIDECAR_MEM_REQ=160Mi
SIDECAR_MEM_LIM=160Mi
PGB_CPU_REQ=5m
PGB_CPU_LIM=100m
PGB_MEM_REQ=48Mi
PGB_MEM_LIM=48Mi
