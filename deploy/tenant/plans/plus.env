# Plan `plus` (plan/03-cost-model.md §4-§5): ₹699 + GST (proposed). Memory request = limit on every container.
PLAN=plus
PG_CPU_REQ=250m
PG_CPU_LIM=1000m
PG_MEM=1Gi
STORAGE=10Gi
MAX_CONNECTIONS=50
SHARED_BUFFERS=256MB
ARCHIVE_TIMEOUT=1min
POOL_MAX_CLIENTS=200
POOL_SIZE=40
SIDECAR_CPU_REQ=5m
SIDECAR_CPU_LIM=200m
SIDECAR_MEM=96Mi
PGB_CPU_REQ=5m
PGB_CPU_LIM=100m
PGB_MEM=48Mi
