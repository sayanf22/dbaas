# Pinned developer and CI tool versions (KEY=version), read by hack/install-tools.sh (plan/05 §3).
# Resolved to the latest stable release on 2026-09-30. Renovate proposes bumps using the
# `# renovate:` line above each entry (renovate.json customManagers).
# Fixed by the plan: K3s and kubectl minor 1.36, Flux 2.9.5, CNPG 1.30.1, Node 24 LTS.

# Languages
# renovate: datasource=golang-version depName=go
GO=1.27.1
# renovate: datasource=node-version depName=node
NODE=24.21.0

# Cluster (same versions locally and on the VMs)
# renovate: datasource=github-releases depName=k3s-io/k3s
K3S=v1.36.4+k3s1
# renovate: datasource=github-releases depName=cloudnative-pg/cloudnative-pg extractVersion=^v(?<version>.+)$
CNPG=1.30.1
# renovate: datasource=github-releases depName=cloudnative-pg/plugin-barman-cloud extractVersion=^v(?<version>.+)$
BARMAN_PLUGIN=0.15.0
# renovate: datasource=github-releases depName=cert-manager/cert-manager extractVersion=^v(?<version>.+)$
CERT_MANAGER=1.21.2
# renovate: datasource=github-releases depName=topolvm/topolvm extractVersion=^topolvm-chart-v(?<version>.+)$
TOPOLVM_CHART=17.2.0
# renovate: datasource=docker depName=ghcr.io/cloudnative-pg/postgresql
POSTGRES=18.6
# renovate: datasource=docker depName=ghcr.io/cloudnative-pg/pgbouncer
PGBOUNCER=1.26.0
